# Copy this file to .env and fill in your values. Never commit .env.
# Required for Gemini models.
GEMINI_API_KEY=

# Optional: where app.db, providers.json and per-user chat state live. Default: ./data
# MISO_DATA_DIR=

# Optional: set to 1 when the web app is served over HTTPS (for example through a tunnel),
# so the login cookie is marked Secure.
# MISO_COOKIE_SECURE=
